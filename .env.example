APP_NAME="SIMPRESMA"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Asia/Jakarta"
APP_URL=http://localhost:8000
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simpresma
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
CACHE_DRIVER=file
CACHE_PREFIX=simpresma_cache

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database

TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="simpresmafasilkom_bot"
TELEGRAM_WEBHOOK_URL="http://localhost:8000/api/telegram/webhook"
TELEGRAM_WEBHOOK_SECRET=""
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_ADMIN_CHAT_IDS=""

SANCTUM_STATEFUL_DOMAINS="localhost,localhost:8000,localhost:8001,localhost:5173,127.0.0.1,127.0.0.1:8000,127.0.0.1:8001,127.0.0.1:5173"
SANCTUM_TOKEN_PREFIX="simpresma_"

CORS_ALLOWED_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001,http://localhost:5173,http://127.0.0.1:5173"

GAPURA_URL="https://gapura.unej.ac.id"
GAPURA_CLIENT_ID=""
GAPURA_CLIENT_SECRET=""
GAPURA_REDIRECT_URI="http://localhost:8000/api/auth/gapura/callback"
GAPURA_FRONTEND_CALLBACK_URL="http://localhost:8000/auth/callback"
GAPURA_LOGOUT_REDIRECT_URI="http://localhost:8000/"

VITE_APP_NAME="${APP_NAME}"
